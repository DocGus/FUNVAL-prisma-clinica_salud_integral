generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum AppointmentStatus {
  PROGRAMADA
  COMPLETADA
  CANCELADA
}

enum UserRole {
  RECEPCIONISTA
  MEDICO
  GERENCIA
}

// ==========================================
// PATIENTS
// ==========================================

model Patient {
  id        String   @id @default(uuid()) @db.Uuid
  firstName String
  lastName  String
  email     String   @unique
  birthDate DateTime @db.Date
  phone     String?

  appointments Appointment[]

  @@map("patients")
}

// ==========================================
// SPECIALTIES
// ==========================================

model Specialty {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  doctors Doctor[]

  @@map("specialties")
}

// ==========================================
// DOCTORS
// ==========================================

model Doctor {
  id                  String  @id @default(uuid()) @db.Uuid
  firstName           String
  lastName            String
  professionalLicense String  @unique
  email               String?
  specialtyId         String  @db.Uuid

  specialty    Specialty     @relation(fields: [specialtyId], references: [id])
  appointments Appointment[]
  user         User?

  @@map("doctors")
}

// ==========================================
// APPOINTMENTS
// ==========================================

model Appointment {
  id        String            @id @default(uuid()) @db.Uuid
  patientId String            @db.Uuid
  doctorId  String            @db.Uuid
  startAt   DateTime          @db.Timestamptz(6)
  status    AppointmentStatus @default(PROGRAMADA)

  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Doctor  @relation(fields: [doctorId], references: [id])

  @@index([doctorId, startAt])
  @@index([patientId, startAt])
  @@index([status, startAt])
  @@map("appointments")
}

// ==========================================
// USERS
// ==========================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  role         UserRole
  doctorId     String?  @unique @db.Uuid

  doctor Doctor? @relation(fields: [doctorId], references: [id])

  @@map("users")
}
